# Pooled connection from Vercel/Neon (required)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Optional. If omitted, the build uses DATABASE_URL_UNPOOLED or DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
# Long random string used to sign login cookies (not the admin password)
SESSION_SECRET="replace-with-a-long-random-string"
