generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MatchStatus {
  waiting
  active
  completed
}

enum Sport {
  football
  volleyball
}

model User {
  id            String        @id
  displayId     String
  isAdmin       Boolean       @default(false)
  passwordHash  String?
  createdAt     DateTime      @default(now())
  createdMatches Match[]      @relation("CreatedMatches")
  memberships   MatchMember[]
  picks         Card[]
  blocks        MatchBlock[]
}

model Match {
  id          String        @id @default(cuid())
  name        String        @default("Match")
  createdById String
  createdBy   User          @relation("CreatedMatches", fields: [createdById], references: [id])
  status      MatchStatus   @default(waiting)
  startedAt   DateTime?
  createdAt   DateTime      @default(now())
  members     MatchMember[]
  cards       Card[]
  blocks      MatchBlock[]
}

model MatchMember {
  matchId String
  userId  String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id])

  @@id([matchId, userId])
}

model MatchBlock {
  matchId String
  userId  String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id])

  @@id([matchId, userId])
}

model Card {
  id           String  @id @default(cuid())
  matchId      String
  match        Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  position     Int
  sport        Sport
  isGoalkeeper Boolean @default(false)
  pickedById   String?
  pickedBy     User?   @relation(fields: [pickedById], references: [id])

  @@unique([matchId, position])
  @@unique([matchId, pickedById])
}
